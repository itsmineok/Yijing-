<Window x:Class="Yijing.Desktop.Views.NewGameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:games="clr-namespace:Yijing.Application.Games;assembly=Yijing.Application"
        xmlns:viewModels="clr-namespace:Yijing.Desktop.ViewModels"
        Title="新对局" Width="500" Height="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="开始一局围棋" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="KataGo 将始终使用当前设备可用的最强配置。" Margin="0,7,0,0"
                       Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,18">
            <TextBlock Text="对局模式" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,9" />
            <WrapPanel>
                <RadioButton Content="人机对弈" GroupName="Mode"
                             IsChecked="{Binding Mode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static games:GameMode.HumanVsAi}}" />
                <RadioButton Content="本地双人" GroupName="Mode"
                             IsChecked="{Binding Mode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static games:GameMode.LocalTwoPlayer}}" />
            </WrapPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,18"
                    Visibility="{Binding IsColorChoiceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="选择执棋" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,9" />
            <WrapPanel>
                <RadioButton Content="执黑" GroupName="Color"
                             IsChecked="{Binding HumanColorChoice, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static viewModels:HumanColorChoice.Black}}" />
                <RadioButton Content="执白" GroupName="Color"
                             IsChecked="{Binding HumanColorChoice, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static viewModels:HumanColorChoice.White}}" />
                <RadioButton Content="随机" GroupName="Color"
                             IsChecked="{Binding HumanColorChoice, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static viewModels:HumanColorChoice.Random}}" />
            </WrapPanel>
            <TextBlock Text="选择执白时，AI 会先完成黑方开局棋。" FontSize="11" Foreground="{StaticResource PrimaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,18">
            <TextBlock Text="棋盘大小" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,9" />
            <WrapPanel>
                <RadioButton Content="19 路" GroupName="Size"
                             IsChecked="{Binding BoardSize, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=19}" />
                <RadioButton Content="13 路" GroupName="Size"
                             IsChecked="{Binding BoardSize, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=13}" />
                <RadioButton Content="9 路" GroupName="Size"
                             IsChecked="{Binding BoardSize, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=9}" />
            </WrapPanel>
        </StackPanel>

        <Border Grid.Row="4" Background="#111B1A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="5" Padding="14" VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="规则" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Grid.Column="1" Text="中国规则 · 贴目 7.5 目" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" MinWidth="88" Margin="0,0,10,0" />
            <Button Content="开始对局" IsDefault="True" MinWidth="112" Click="OnStartClick"
                    Background="#285D50" BorderBrush="{StaticResource PrimaryBrush}" />
        </StackPanel>
    </Grid>
</Window>
