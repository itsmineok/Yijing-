<Window x:Class="Yijing.Desktop.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="设置" Width="520" Height="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="设置" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="AI 思考时间随手数递增，开局快、后程慢。" Margin="0,7,0,0"
                       Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="AI 思考时间" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                   Margin="0,0,0,9" />

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="开局思考时长（秒）" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding OpeningSeconds, UpdateSourceTrigger=PropertyChanged}" FontSize="15"
                         Padding="8,6" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="思考时长上限（秒）" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding MaxSeconds, UpdateSourceTrigger=PropertyChanged}" FontSize="15"
                         Padding="8,6" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3" Text="开局第 1 手使用开局时长，之后线性递增，第 150 手及以后使用上限（1~600 秒）。"
                   FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
        <TextBlock Grid.Row="4" Text="{Binding ErrorText}" FontSize="11" Foreground="{StaticResource ResignBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,18" />

        <Border Grid.Row="5" Background="#111B1A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="5" Padding="14" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="KATAGO 引擎" FontSize="11" Foreground="{StaticResource PrimaryBrush}" />
                <TextBlock Text="重新基准测试各后端（TensorRT / OpenCL / CPU），并自动切换到最快的引擎。TensorRT 首次运行需要几分钟构建引擎。"
                           FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                           Margin="0,5,0,10" />
                <Button Content="重新基准测试" Command="{Binding RebenchmarkCommand}" HorizontalAlignment="Left"
                        automation:AutomationProperties.Name="重新基准测试" />
                <TextBlock Text="{Binding RebenchmarkStatusText}" FontSize="11"
                           Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" IsCancel="True" MinWidth="88" Margin="0,0,10,0" />
            <Button Content="确定" IsDefault="True" MinWidth="112" Click="OnConfirmClick"
                    Background="#285D50" BorderBrush="{StaticResource PrimaryBrush}" />
        </StackPanel>
    </Grid>
</Window>
