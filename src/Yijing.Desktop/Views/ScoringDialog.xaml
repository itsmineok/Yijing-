<Window x:Class="Yijing.Desktop.Views.ScoringDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Yijing.Desktop.Controls"
        Title="终局数子" Width="720" Height="760" MinWidth="600" MinHeight="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="终局数子" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="点击棋子可将整块标记为死子或恢复为活子。AI 标记仅供参考。"
                       Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,14" />
        </StackPanel>
        <Border Grid.Row="1" Background="#0D1514" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="10">
            <controls:GoBoardControl State="{Binding State}" DeadStones="{Binding DeadStones}"
                                     PlayCommand="{Binding ToggleDeadCommand}" IsInputEnabled="True"
                                     ShowCoordinates="True" />
        </Border>
        <TextBlock Grid.Row="2" Text="{Binding ScoreText}" FontSize="17" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,16" />
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="继续对局" Click="OnContinueClick" />
            <Button Grid.Column="2" Content="确认结果" Click="OnConfirmClick"
                    Background="#2D7566" />
        </Grid>
    </Grid>
</Window>
