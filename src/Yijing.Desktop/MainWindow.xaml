<Window x:Class="Yijing.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Yijing.Desktop.Controls"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        mc:Ignorable="d"
        Title="弈境 · 专业围棋分析台" Height="820" Width="1280"
        Icon="Assets/Yijing.ico"
        MinHeight="720" MinWidth="1024" WindowStartupLocation="CenterScreen"
        Closing="OnWindowClosing">
    <Grid Background="{StaticResource BackgroundBrush}" DataContext="{Binding CurrentGame}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="弈境" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock Text="  YIJING GO" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="6,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NewGameButton" Content="新对局" Click="OnNewGameClick" Margin="0,0,8,0"
                            automation:AutomationProperties.Name="新对局" />
                    <Button Content="打开 SGF" Margin="0,0,8,0" automation:AutomationProperties.Name="打开 SGF" />
                    <Button Content="保存" automation:AutomationProperties.Name="保存棋谱" />
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding TurnText, FallbackValue=黑方行棋}" HorizontalAlignment="Center"
                           FontSize="15" FontWeight="SemiBold" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Content="坐标" IsChecked="{Binding ShowCoordinates, ElementName=Board, Mode=TwoWay}"
                                  Margin="0,0,8,0" automation:AutomationProperties.Name="显示棋盘坐标" />
                    <ToggleButton Content="分析" IsChecked="{Binding IsAnalysisVisible, Mode=TwoWay, FallbackValue=True}"
                                  Margin="0,0,8,0" automation:AutomationProperties.Name="显示局面分析" />
                    <Button x:Name="SettingsButton" Content="设置" Click="OnSettingsClick"
                            automation:AutomationProperties.Name="打开设置" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="24" Background="#0D1514" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12">
                <controls:GoBoardControl x:Name="Board" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                         State="{Binding State}" Candidates="{Binding Candidates}"
                                         LastMove="{Binding LastMove}" PlayCommand="{Binding PlayCommand}"
                                         IsInputEnabled="{Binding IsInputEnabled}" ShowCoordinates="True"
                                         automation:AutomationProperties.Name="围棋棋盘" />
            </Border>

            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="对局" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,10" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1D2B28" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12">
                                    <StackPanel>
                                        <Ellipse Width="18" Height="18" Fill="#111514" Stroke="#52615D" HorizontalAlignment="Left" />
                                        <TextBlock Text="黑方" FontWeight="SemiBold" Margin="0,8,0,2" />
                                        <TextBlock Text="BLACK" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="#1D2B28" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12">
                                    <StackPanel>
                                        <Ellipse Width="18" Height="18" Fill="#F1F4F2" Stroke="#9AA7A3" HorizontalAlignment="Left" />
                                        <TextBlock Text="白方" FontWeight="SemiBold" Margin="0,8,0,2" />
                                        <TextBlock Text="WHITE" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Background="#111B1A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="KATAGO 分析" FontSize="11" Foreground="{StaticResource PrimaryBrush}" />
                                    <TextBlock Text="{Binding EngineStatusText, FallbackValue=AI 准备完成}" FontSize="13" Margin="0,5,0,12" />
                                    <Grid Visibility="{Binding IsAnalysisVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Visible}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="胜率" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Text="{Binding WinrateText, FallbackValue=胜率：--}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="预计目差" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Text="{Binding ScoreLeadText, FallbackValue=目差：--}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <Button Content="重新分析" Command="{Binding RetryAiCommand}" Margin="0,12,0,0" automation:AutomationProperties.Name="重新分析" />
                                </StackPanel>
                            </Border>

                            <StackPanel Visibility="{Binding IsAnalysisVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Visible}">
                                <TextBlock Text="候选点" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Candidates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1D2B28" CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="26" Height="26" Background="#2D7566" CornerRadius="13">
                                                        <TextBlock Text="{Binding Move}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Winrate, StringFormat={}{0:P1}}" Margin="8,0,0,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding ScoreLead, StringFormat={}{0:+0.0;-0.0;0.0}目}" Foreground="{StaticResource MutedTextBrush}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock Text="对局信息" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,8" />
                            <Border Background="#111B1A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="模式" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,7" />
                                    <TextBlock Grid.Column="1" Text="{Binding ModeText, FallbackValue=人机对弈}" Margin="0,0,0,7" />
                                    <TextBlock Grid.Row="1" Text="手数" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,7" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding State.MoveNumber, FallbackValue=0}" Margin="0,0,0,7" />
                                    <TextBlock Grid.Row="2" Text="规则" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,7" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="中国规则 · 7.5目" Margin="0,0,0,7" />
                                    <TextBlock Grid.Row="3" Text="棋盘" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BoardSizeText, FallbackValue=19 路}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="悔棋" Command="{Binding UndoCommand}" automation:AutomationProperties.Name="悔棋" Padding="6,8" />
                        <Button Grid.Column="2" Content="停一手" Command="{Binding PassCommand}" automation:AutomationProperties.Name="停一手" Padding="6,8" />
                        <Button Grid.Column="4" Content="认输" Command="{Binding ResignCommand}" Foreground="{StaticResource ResignBrush}"
                                automation:AutomationProperties.Name="认输" Padding="6,8" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
